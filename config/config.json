{
  "proyecto": "Argo",
  "version": "0.1.0",
  "timezone": "America/Argentina/Buenos_Aires",
  "paths": {
    "data_raw": "data/raw",
    "data_processed": "data/processed",
    "data_backtests": "data/backtests",
    "database": "data/argo.sqlite",
    "logs": "logs",
    "dashboards": "dashboards"
  },
  "logging": {
    "nivel": "INFO",
    "rotacion": "diaria",
