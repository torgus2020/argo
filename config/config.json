    },
    "us": {
      "apertura": "09:30",
      "cierre": "16:00",
      "zona_horaria": "America/New_York"
    }
  },
  "roadmap": {
    "engine_hora_corrida": "09:00",
    "engine_timezone": "America/Argentina/Buenos_Aires",
    "dias_anticipacion_target": 3
  },
  "modo_ejecucion": {
    "default": "propose_and_confirm",
    "auto_permitido_solo_con_criterios": true
  }
